# ==============================================================================
# Brightloop Software - Subscription Management System
# Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to `.env` for local development:
#    cp .env.example .env
# 2. Fill in your actual local configuration values in `.env`.
# 3. NEVER commit `.env` or any file containing real passwords or API keys to Git.
# 4. In Netlify (Production), set these environment variables in Site settings > Environment variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# App Environment
# ------------------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:8888

# ------------------------------------------------------------------------------
# Database Configuration (MySQL)
# Option A: Individual connection settings (recommended for local development)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_local_mysql_password
DB_NAME=brightloop_subscriptions
DB_SSL=false

# Option B: Single connection URI string (supported by cloud MySQL providers e.g. PlanetScale, Aiven, AWS RDS)
# DATABASE_URL=mysql://root:your_local_mysql_password@127.0.0.1:3306/brightloop_subscriptions
# NOTE: Netlify Functions cannot connect to localhost or personal laptop IP addresses in production.

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
# Use a strong, random string (at least 32 characters) for signing JWT tokens.
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# Brevo Email Service (Transactional Emails: Password Reset, Invoices, Alerts)
# ------------------------------------------------------------------------------
# Get your API key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_v3_api_key_placeholder
BREVO_SENDER_EMAIL=notifications@brightloopsoftware.example.com
BREVO_SENDER_NAME="Brightloop Software"
